# Ludus cache rules.
# Read by Cloudflare (Workers static assets / Pages) and Netlify. Surge ignores this file: it always sends
# "Cache-Control: public, max-age=0, must-revalidate" (see PERFORMANCE.md for what to do about that).

# Pages, the service workers and the server list are always re-checked, so an edit shows up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache
/sw-static-cache.js
  Cache-Control: no-cache
/resolver-servers.js
  Cache-Control: no-cache
/ludus-servers.js
  Cache-Control: no-cache

# Our own code is loaded as name.js?v=<hash> (run  node tools/stamp-assets.mjs  before each deploy), so any change is a
# new URL and these can safely be cached for a year.
/script.js
  Cache-Control: public, max-age=31536000, immutable
/credits-data.js
  Cache-Control: public, max-age=31536000, immutable
/auth.js
  Cache-Control: public, max-age=31536000, immutable
/ludus-core.js
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable

# Game thumbnails and other pictures: stable files, 30 days, and a stale copy may be shown for a day while it refreshes.
/Versions/Assets/Pictures/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
